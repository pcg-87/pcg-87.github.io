source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed",     "~> 0.17"
  gem "jekyll-archives", "~> 2.3"
  gem "jekyll-seo-tag",  "~> 2.9"
end

# Rouge does build-time syntax highlighting. Pinned so a major bump can't
# silently rename the CSS classes that assets/css/main.scss targets.
gem "rouge", "~> 5.1"

# Required on Ruby 3.4+, where these left the standard library.
gem "csv"
gem "base64"
gem "bigdecimal"
